# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
backups/

# the Android (TWA) build — the PROJECT is generated from android/twa-manifest.json
# by `bubblewrap update`, so only that file and the runbook are worth keeping.
# ⚠️ THE KEYSTORE AND ITS PASSWORD ARE NEVER COMMITTED. Anyone holding both can
# sign an update to Sodio. (It is the UPLOAD key, not the app-signing key —
# Play can reset it if it is ever lost, which is the whole point of Play App
# Signing — but it is still a credential.)
/android/*
!/android/twa-manifest.json
!/android/README.md
